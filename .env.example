# Copy to .env and fill in. .env is git-ignored.

# --- GitHub auth ---
# CLI-now approach: on the host run `gh auth token` and paste it here, or export
# GH_TOKEN="$(gh auth token)" before `docker compose up`. Token needs push access
# to the target repos (traffic endpoints require it). Leave blank to let the
# collector shell out to `gh auth token` when running on the host (non-container).
GH_TOKEN=

# --- repositories to track (comma-separated owner/repo) ---
REPOS=maifeeulasad/lilac

# --- collector behaviour ---
# how many trailing days to pull each run (1-2 for daily; up to 14 for backfill)
COLLECT_DAYS=2
# path to the SQLite db (inside the container / process)
DB_PATH=/data/traffic.db

# --- grafana ---
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=admin
