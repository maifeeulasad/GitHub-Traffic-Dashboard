# Copy to .env and fill in. .env is git-ignored.

# --- GitHub auth ---
# CLI-now approach: on the host run `gh auth token` and paste it here, or export
# GH_TOKEN="$(gh auth token)" before `docker compose up`. Token needs push access
# to the target repos (traffic endpoints require it). Leave blank to let the
# collector shell out to `gh auth token` when running on the host (non-container).
GH_TOKEN=

# --- repositories to track (comma-separated owner/repo) ---
# Generate the full ordered list (owned first, then forks, newest push first):
#   gh repo list <owner> -L 2000 --json nameWithOwner,isFork,pushedAt --jq '
#     (map(select(.isFork|not))|sort_by(.pushedAt)|reverse)
#     + (map(select(.isFork))|sort_by(.pushedAt)|reverse) | map(.nameWithOwner)|join(",")'
REPOS=maifeeulasad/lilac

# --- collector behaviour ---
# how many trailing days to pull each run (1-2 for daily; 14 = all GitHub keeps)
COLLECT_DAYS=14
# seconds to pause between repos (politeness for large repo sets; 0 = none)
REPO_DELAY=0.3
# path to the SQLite db (inside the container / process)
DB_PATH=/data/traffic.db

# --- grafana ---
# Login is disabled in docker-compose.yml (anonymous Admin) for local use.
# Re-enable auth there if you expose Grafana beyond localhost.
